{
  "name": "deadlock-helper",
  "productName": "Soulsight",
  "version": "0.4.0",
  "description": "Soulsight: overlay local pentru Deadlock, recunoaste eroii din HUD si recomanda iteme contra echipei adverse.",
  "author": "Joltarise",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.joltarise.deadlockhelper",
    "productName": "Soulsight",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "*.css",
      "panel.js",
      "report.js",
      "i18n.js"
    ],
    "extraResources": [
      {
        "from": "../dist/dlh-engine",
        "to": "engine"
      },
      {
        "from": "../icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "../icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Soulsight.exe",
      "shortcutName": "Soulsight",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CyberKird",
        "repo": "deadlock-helper"
      }
    ]
  }
}
